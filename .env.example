# ===================================================================
# SMART OFFICE MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Copy this file to .env and provide your actual values.
# NEVER commit the real .env file into source control.

# Server Configuration
PORT=8080

# Database Configuration (Aiven Cloud MySQL)
# Example host: mysql-xxxx-your-project.aivencloud.com
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_office
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_SSL_MODE=REQUIRED

# CORS Allowed Origins (Comma separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Security Configuration
# Secret must be a secure base64 or 256-bit string
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRATION=86400000

# Initial Admin Account (Optional - creates initial admin on startup if provided and does not exist)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@smartoffice.com
INITIAL_ADMIN_PASSWORD=change-this-to-a-secure-password

# AI Configuration (Free Local AI with Fallback)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
